# ==========================================
# Multi-Stack .gitignore
# Python, Node.js, Rust, .NET, IDEs, OS
# ==========================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
*.mdf
*.ldf

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/

# --- Node.js / React ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.vite/
frontend/dist/
frontend/build/

# --- Rust ---
rust-mcp-client/target/
target/
**/*.rs.bk
*.pdb

# --- .NET / C# ---
dotnet-mcp-server/bin/
dotnet-mcp-server/obj/
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs

# --- IDE & Editors ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Temporary Files & Microsoft Office Lock Files ---
~$*
*.tmp
*.temp
