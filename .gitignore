# ==========================================
# Multi-Stack .gitignore
# Python, Node.js / React, Rust, .NET, SQL Server, IDEs, OS, Tests
# ==========================================

# --- Environment & Secrets ---
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# --- Tests, Test Results & Coverage ---
tests/
test/
TestResults/
*.trx
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage/
*.cover
.hypothesis/
.nyc_output/

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.mypy_cache/
.ruff_cache/
pip-log.txt
pip-delete-this-directory.txt

# --- Node.js / React ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*
.vite/
frontend/dist/
frontend/build/
out/
.next/
.nuxt/
.turbo/
.eslintcache
.stylelintcache
*.tsbuildinfo

# --- Rust ---
rust-mcp-client/target/
target/
**/*.rs.bk
*.pdb

# --- .NET / C# ---
.vs/
dotnet-mcp-server/bin/
dotnet-mcp-server/obj/
bin/
obj/
[Dd]ebug/
[Rr]elease/
[Bb]uildLog.*
*.user
*.userosscache
*.sln.docstates
*.suo
*.userprefs
*.publishproj
packages/
*.nupkg

# --- Database & SQL Server ---
*.mdf
*.ldf
*.bak
*.bacpac
*.dacpac
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# --- Logs ---
*.log
logs/

# --- IDEs & Editors ---
.idea/
.vscode/
*.code-workspace
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Operating System ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/

# --- Temporary, Cache & Scratch Files ---
tmp/
temp/
scratch/
~$*
*.tmp
*.temp
*.bak
*.backup
*.cache
