# ==========================================
# Environment Configuration Template
# DO NOT commit actual secrets or credentials
# ==========================================

# Database Configuration (Used by .NET MCP Server)
DB_SERVER=localhost
DB_NAME=InternAgenticDB
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_TRUST_SERVER_CERTIFICATE=true

# Python FastAPI Gateway Configuration
BACKEND_PORT=8000
BACKEND_HOST=127.0.0.1
RUST_SERVICE_URL=http://127.0.0.1:5000

# Rust MCP Client Configuration
RUST_PORT=5000
DOTNET_MCP_SERVER_PATH=../dotnet-mcp-server/bin/Debug/net8.0/dotnet-mcp-server.dll

# React Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8000/api
